#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=../lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

mkdir -p "$ASDF_DOWNLOAD_PATH"

release_file="$ASDF_DOWNLOAD_PATH/d2-v${ASDF_INSTALL_VERSION}-$(get_platform)-$(get_arch).tar.gz"
download_release "$ASDF_INSTALL_VERSION" "$release_file"
tar -xzf "$release_file" -C "$ASDF_DOWNLOAD_PATH" \
	"d2-v${ASDF_INSTALL_VERSION}" || fail "Could not extract D2 from $release_file"
rm "$release_file"
